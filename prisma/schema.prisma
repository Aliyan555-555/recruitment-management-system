// This is your Prisma schema file for Recruitment Management System
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// User Management
// ============================================

model User {
  id           BigInt     @id @default(autoincrement())
  role         UserRole   @default(CANDIDATE)
  userStatus   UserStatus @default(ACTIVE) @map("user_status")
  username     String     @unique @db.VarChar(100)
  password     String     @db.VarChar(255)
  firstname    String     @db.VarChar(100)
  lastname     String     @db.VarChar(100)
  email        String     @unique @db.VarChar(100)
  phone1       String?    @db.VarChar(20)
  phone2       String?    @db.VarChar(20)
  institution  String?    @db.VarChar(255)
  department   String?    @db.VarChar(255)
  address      String?    @db.VarChar(255)
  city         String?    @db.VarChar(120)
  country      String?    @db.VarChar(2)
  lang         String?    @db.VarChar(30)
  theme        String?    @db.VarChar(50)
  timezone     String?    @db.VarChar(100)
  firstAccess  BigInt?    @map("first_access")
  lastAccess   BigInt?    @map("last_access")
  lastLogin    BigInt?    @map("last_login")
  currentLogin BigInt?    @map("current_login")
  deletedAt    BigInt?    @map("deleted_at")
  suspended    Boolean    @default(false)
  createdAt    BigInt     @map("created_at")
  updatedAt    BigInt     @map("updated_at")
  avatar       String?    @db.VarChar(255)

  // Relations
  educations     UserEducation[]
  skills         UserSkills[]
  experiences    UserExperience[]
  profileDetails UserProfileDetail?
  jobPreference  UserJobPreference?
  jobsCreated    Job[]              @relation("JobCreator")
  jobsUpdated    Job[]              @relation("JobUpdater")
  jobsApplied    JobsApplied[]
  jobsBookmarked JobsBookmark[]

  // Workflow Relations
  candidateInterviews     Interview[]             @relation("CandidateInterviews")
  candidatePipelines      CandidatePipeline[]     @relation("CandidatePipelines")
  auditLogs               AuditLog[]              @relation("AuditLogs")
  notifications           Notification[]          @relation("UserNotifications")
  slotBookings            SlotBooking[]
  quickTestAttempts       QuickTestAttempt[]
  stageEvaluations        StageEvaluation[]
  lois                    LetterOfIntent[]        @relation("CandidateLOIs")
  offerLetters            OfferLetter[]           @relation("CandidateOfferLetters")

  // Batch Relations
  batchesCreated             Batch[]                    @relation("BatchCreator")
  batchCandidatesEvaluated   BatchCandidateEvaluation[]
  batchCandidates            BatchCandidate[]           @relation("BatchCandidateEvaluator")
  batchCandidatesEvaluatedBy BatchCandidate[]           @relation("BatchCandidateEvaluatorUser")

  // Password Reset Relations
  passwordResetTokens PasswordResetToken[]
  skillAssessments    SkillAssessment[]
  aiShortlistRunsTriggered AiShortlistRun[]            @relation("AiShortlistRunTriggeredBy")
  aiShortlistResults       AiCandidateShortlistResult[] @relation("AiShortlistCandidateResults")

  @@index([role])
  @@index([userStatus])
  @@map("user")
}

model PasswordResetToken {
  id        BigInt  @id @default(autoincrement())
  userId    BigInt  @map("user_id")
  token     String  @unique @db.VarChar(255)
  expiresAt BigInt  @map("expires_at")
  usedAt    BigInt? @map("used_at")
  createdAt BigInt  @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model UserEducation {
  id               BigInt  @id @default(autoincrement())
  userId           BigInt  @map("user_id")
  educationLevelId BigInt  @map("education_level_id")
  degreeTitle      String  @db.VarChar(255)
  institute        String? @db.VarChar(255)
  instituteId      BigInt? @map("institute_id")
  majorSubject     String? @db.VarChar(255)
  grade            String? @db.VarChar(50)
  passingYear      String? @db.VarChar(50)
  country          String? @db.VarChar(50)
  createdAt        BigInt  @map("created_at")
  updatedAt        BigInt  @map("updated_at")

  // Relations
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel UserEducationLevel @relation(fields: [educationLevelId], references: [id])
  instituteRef   Institute?         @relation(fields: [instituteId], references: [id])

  @@index([userId])
  @@index([educationLevelId])
  @@index([instituteId])
  @@map("user_education")
}

model UserEducationLevel {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(100)

  // Relations
  userEducations           UserEducation[]
  jobEducationRequirements JobEducationRequirement[]

  @@map("user_education_level")
}

model UserSkills {
  id               BigInt              @id @default(autoincrement())
  userId           BigInt              @map("user_id")
  skillName        String              @db.VarChar(255)
  level            Int
  verifiedLevel    VerifiedSkillLevel? @map("verified_level")
  verifiedAt       BigInt?             @map("verified_at")
  lastAssessmentId BigInt?             @map("last_assessment_id")
  createdAt        BigInt              @map("created_at")
  updatedAt        BigInt              @map("updated_at")

  // Relations
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments SkillAssessment[]

  @@index([userId])
  @@index([verifiedLevel])
  @@index([skillName])
  @@unique([userId, skillName])
  @@map("user_skills")
}

model SkillAssessmentConfig {
  id                    BigInt  @id @default(autoincrement())
  skillName             String  @unique @map("skill_name") @db.VarChar(255)
  questionCount         Int     @default(10) @map("question_count")
  minPassPoints         Int     @default(60) @map("min_pass_points")
  maxPoints             Int     @default(100) @map("max_points")
  levelThresholds       Json    @map("level_thresholds")
  maxAttempts           Int     @default(3) @map("max_attempts")
  cooldownHours         Int     @default(24) @map("cooldown_hours")
  cycleResetDays        Int     @default(7) @map("cycle_reset_days")
  attemptTimeoutMinutes Int     @default(60) @map("attempt_timeout_minutes")
  isActive              Boolean @default(true) @map("is_active")
  createdAt             BigInt  @map("created_at")
  updatedAt             BigInt  @map("updated_at")

  @@map("skill_assessment_config")
}

model SkillAssessment {
  id            BigInt                @id @default(autoincrement())
  userSkillId   BigInt                @map("user_skill_id")
  userId        BigInt                @map("user_id")
  skillName     String                @map("skill_name") @db.VarChar(255)
  status        SkillAssessmentStatus @default(IN_PROGRESS)
  attemptNumber Int                   @map("attempt_number")
  minPoints     Int                   @map("min_points")
  maxPoints     Int                   @map("max_points")
  totalPoints   Int                   @map("total_points")
  scoredPoints  Int?                  @map("scored_points")
  level         VerifiedSkillLevel?
  startedAt     BigInt                @map("started_at")
  submittedAt   BigInt?               @map("submitted_at")
  expiresAt     BigInt?               @map("expires_at")
  createdAt     BigInt                @map("created_at")
  updatedAt     BigInt                @map("updated_at")

  userSkill UserSkills           @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]
  answers   AssessmentAnswer[]

  @@unique([userSkillId, attemptNumber])
  @@index([userSkillId])
  @@index([userId])
  @@index([skillName])
  @@index([status])
  @@index([level])
  @@index([submittedAt])
  @@map("skill_assessment")
}

model AssessmentQuestion {
  id            BigInt @id @default(autoincrement())
  assessmentId  BigInt @map("assessment_id")
  question      String @db.Text
  options       Json
  correctOption String @map("correct_option") @db.VarChar(500)
  points        Int
  order         Int

  assessment SkillAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]

  @@unique([assessmentId, order])
  @@index([assessmentId])
  @@map("assessment_question")
}

model AssessmentAnswer {
  id             BigInt  @id @default(autoincrement())
  assessmentId   BigInt  @map("assessment_id")
  questionId     BigInt  @map("question_id")
  selectedOption String  @map("selected_option") @db.VarChar(500)
  isCorrect      Boolean @map("is_correct")
  pointsAwarded  Int     @map("points_awarded")
  createdAt      BigInt  @map("created_at")

  assessment SkillAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@map("assessment_answer")
}

model UserExperience {
  id        BigInt  @id @default(autoincrement())
  userId    BigInt  @map("user_id")
  jobTitle  String  @db.VarChar(255)
  company   String? @db.VarChar(255)
  location  String? @db.VarChar(255)
  startDate String? @map("start_date") @db.VarChar(50)
  endDate   String? @map("end_date") @db.VarChar(50)
  isCurrent Boolean @default(false) @map("is_current")
  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_experience")
}

model UserProfileDetail {
  id                BigInt  @id @default(autoincrement())
  userId            BigInt  @unique @map("user_id")
  title             String? @db.VarChar(50)
  fatherName        String? @map("father_name") @db.VarChar(255)
  religion          String? @db.VarChar(100)
  nationality       String? @db.VarChar(120)
  dateOfBirth       String? @map("date_of_birth") @db.VarChar(30)
  cnic              String? @db.VarChar(50)
  gender            String? @db.VarChar(50)
  maritalStatus     String? @map("marital_status") @db.VarChar(50)
  preferredCity     String? @map("preferred_city") @db.VarChar(120)
  postalCode        String? @map("postal_code") @db.VarChar(20)
  disclaimersAgreed Boolean @default(false) @map("disclaimers_agreed")
  professionalGrade String? @map("professional_grade") @db.VarChar(50)
  linkedinUrl       String? @map("linkedin_url") @db.VarChar(255)
  portfolioUrl      String? @map("portfolio_url") @db.VarChar(255)
  githubUrl         String? @map("github_url") @db.VarChar(255)
  websiteUrl        String? @map("website_url") @db.VarChar(255)
  bio               String? @db.Text
  availability      String? @db.VarChar(100)
  expectedSalary    String? @map("expected_salary") @db.VarChar(100)
  noticePeriod      String? @map("notice_period") @db.VarChar(50)
  languages         String? @db.Text
  certifications    String? @db.Text
  achievements      String? @db.Text
  references        String? @db.Text
  createdAt         BigInt  @map("created_at")
  updatedAt         BigInt  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile_detail")
}

model UserJobPreference {
  id             BigInt  @id @default(autoincrement())
  userId         BigInt  @unique @map("user_id")
  firstPriority  String? @map("first_priority") @db.VarChar(255)
  secondPriority String? @map("second_priority") @db.VarChar(255)
  thirdPriority  String? @map("third_priority") @db.VarChar(255)
  summary        String? @db.Text
  createdAt      BigInt  @map("created_at")
  updatedAt      BigInt  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_job_preference")
}

// ============================================
// Jobs & Applications
// ============================================

model Job {
  id                BigInt         @id @default(autoincrement())
  jobCode           String         @unique @map("job_code") @db.VarChar(50)
  title             String         @db.VarChar(255)
  shortDescription  String?        @map("short_description") @db.VarChar(500)
  description       String?        @db.Text
  company           String         @db.VarChar(255)
  postFrom          DateTime       @map("post_from") @db.Date
  postTo            DateTime       @map("post_to") @db.Date
  status            Boolean        @default(true)
  jobType           JobType        @default(NORMAL) @map("job_type")
  jobStatus         JobStatus      @default(ACTIVE) @map("job_status")
  industry          String?        @db.VarChar(255)
  employmentType    EmploymentType @map("employment_type")
  employmentShift   String?        @db.VarChar(50)
  totalPositions    Int?           @default(1) @map("total_positions")
  minimumExperience String?        @db.VarChar(255)
  certification     String?        @db.Text
  minimumSalary     String?        @db.VarChar(50)
  benefits          String?        @db.Text
  successCriteria   String?        @db.Text @map("success_criteria")
  createdBy         BigInt         @map("created_by")
  updatedBy         BigInt?        @map("updated_by")
  createdAt         BigInt         @map("created_at")
  updatedAt         BigInt         @map("updated_at")
  deletedAt         BigInt?        @map("deleted_at")

  // Relations
  creator               User                      @relation("JobCreator", fields: [createdBy], references: [id])
  updater               User?                     @relation("JobUpdater", fields: [updatedBy], references: [id])
  skills                JobSkill[]
  applications          JobsApplied[]
  bookmarks             JobsBookmark[]
  workflow              JobWorkflow?
  pipelines             CandidatePipeline[]
  locations             JobLocation[]
  educationRequirements JobEducationRequirement[]
  batches               Batch[]
  lois                  LetterOfIntent[]
  offerLetters          OfferLetter[]
  aiShortlistRuns       AiShortlistRun[]
  aiShortlistResults    AiCandidateShortlistResult[]
  quickTest             JobQuickTest?
  quickTestAttempts     QuickTestAttempt[]

  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([jobCode])
  @@index([deletedAt])
  @@index([jobType])
  @@index([jobStatus])
  @@map("jobs")
}

enum EmploymentType {
  Permanent
  PartTime  @map("Part Time")
  Contract
}

enum JobType {
  NORMAL
  BULK
}

enum JobStatus {
  ACTIVE
  ADMIN_SHORTLISTING
  CLOSED
}

model JobSkill {
  id        BigInt           @id @default(autoincrement())
  jobId     BigInt           @map("job_id")
  skillName String           @db.VarChar(255)
  priority  JobSkillPriority @default(REQUIRED)

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@unique([jobId, skillName])
  @@map("job_skills")
}

enum JobSkillPriority {
  REQUIRED
  PREFERRED
}

model JobLocation {
  id        BigInt  @id @default(autoincrement())
  jobId     BigInt  @map("job_id")
  city      String  @db.VarChar(255)
  country   String? @db.VarChar(50)
  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_locations")
}

model JobEducationRequirement {
  id               BigInt  @id @default(autoincrement())
  jobId            BigInt  @map("job_id")
  educationLevelId BigInt  @map("education_level_id")
  field            String? @db.VarChar(255)
  minimumGpa       String? @map("minimum_gpa") @db.VarChar(50)
  gpaScale         String? @map("gpa_scale") @db.VarChar(50)
  isRequired       Boolean @default(true) @map("is_required")
  notes            String? @db.Text
  createdAt        BigInt  @map("created_at")
  updatedAt        BigInt  @map("updated_at")

  // Relations
  job            Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  educationLevel UserEducationLevel @relation(fields: [educationLevelId], references: [id])

  @@index([jobId])
  @@index([educationLevelId])
  @@map("job_education_requirements")
}

model JobsApplied {
  id              BigInt            @id @default(autoincrement())
  jobId           BigInt            @map("job_id")
  userId          BigInt            @map("user_id")
  status          ApplicationStatus @default(SUBMITTED)
  appliedAt       BigInt            @map("applied_at")
  statusUpdatedAt BigInt?           @map("status_updated_at")
  note            String?           @db.Text
  batchId         BigInt?           @map("batch_id")

  // Relations
  job             Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipeline        CandidatePipeline?
  slotBookings    SlotBooking[]
  batch           Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchCandidates BatchCandidate[]

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([batchId])
  @@map("jobs_applied")
}

enum ApplicationStatus {
  APPLIED
  BOOKMARKED
  REMOVED
  SUBMITTED
  SHORTLISTED
  BATCH_ASSIGNED
}

model JobsBookmark {
  id        BigInt  @id @default(autoincrement())
  jobId     BigInt  @map("job_id")
  userId    BigInt  @map("user_id")
  status    Boolean @default(true)
  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")

  // Relations
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@map("jobs_bookmark")
}

// Supporting Tables
// ============================================

model Institute {
  id        BigInt  @id @default(autoincrement())
  name      String  @db.VarChar(255)
  visible   Boolean @default(true)
  deletedAt BigInt? @map("deleted_at")

  // Relations
  educations UserEducation[]

  @@index([deletedAt])
  @@map("institute")
}

// ============================================
// Workflow System Enums
// ============================================

enum UserRole {
  ADMIN
  CANDIDATE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum StepStatus {
  ACTIVE
  INACTIVE
}

enum PipelineStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
  ON_HOLD
}

enum StepInstanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  REJECTED
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  ASSIGNED
  COMPLETED
  SKIPPED
  REJECTED
  OVERRIDDEN
  ADVANCED
  REOPENED
}

enum NotificationType {
  ASSIGNMENT
  COMPLETION
  REJECTION
  REMINDER
  SYSTEM
}

enum StepType {
  TEST
  SCREENING_INTERVIEW
  FOCUS_GROUP
  FINAL_INTERVIEW
  OFFER
}

enum LetterStatus {
  DRAFTED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// ============================================
// Workflow System Models
// ============================================

model JobWorkflow {
  id        BigInt @id @default(autoincrement())
  jobId     BigInt @unique @map("job_id")
  createdAt BigInt @map("created_at")
  updatedAt BigInt @map("updated_at")

  job   Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  steps WorkflowStep[]

  @@map("job_workflow")
}

model WorkflowStep {
  id               BigInt     @id @default(autoincrement())
  workflowId       BigInt     @map("workflow_id")
  stepName         String     @map("step_name") @db.VarChar(255)
  stepType         StepType?  @map("step_type")
  stepOrder        Int        @map("step_order")
  isRequired       Boolean    @default(true) @map("is_required")
  isSkippable      Boolean    @default(false) @map("is_skippable")
  status           StepStatus @default(ACTIVE)
  createdAt        BigInt     @map("created_at")
  updatedAt        BigInt     @map("updated_at")
  evaluationSchema Json?
  capacityPerSlot  Int?
  stepMetadata     Json?      @map("step_metadata") // Stores durationMins, weightage, scoreThreshold, interviewMode, meetingLink, interviewerIds, routeVisibility, evaluationCriteria, candidateInstructions, interviewerInstructions, skipReason, attachments (metadata)

  workflow      JobWorkflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  pipelineSteps CandidatePipelineStep[]
  slots         InterviewSlot[]
  batches       Batch[]

  @@index([workflowId])
  @@map("workflow_step")
}

// Interviewer availability slots per workflow step
model InterviewSlot {
  id            BigInt   @id @default(autoincrement())
  stepId        BigInt   @map("step_id")
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int      @default(1)
  isBlocked     Boolean  @default(false)
  createdAt     BigInt   @map("created_at")
  updatedAt     BigInt   @map("updated_at")

  step        WorkflowStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  bookings    SlotBooking[]

  @@index([stepId])
  @@map("interview_slot")
}

// Concurrency-safe bookings per slot
model SlotBooking {
  id            BigInt        @id @default(autoincrement())
  slotId        BigInt        @map("slot_id")
  candidateId   BigInt        @map("candidate_id")
  applicationId BigInt        @map("application_id")
  status        BookingStatus @default(RESERVED)
  createdAt     BigInt        @map("created_at")
  updatedAt     BigInt        @map("updated_at")

  slot        InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  candidate   User          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application JobsApplied   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([slotId, candidateId])
  @@index([slotId])
  @@map("slot_booking")
}

enum BookingStatus {
  RESERVED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// Per-stage evaluation
model StageEvaluation {
  id             BigInt                   @id @default(autoincrement())
  pipelineStepId BigInt                   @map("pipeline_step_id")
  evaluatorId    BigInt                   @map("evaluator_id")
  formData       Json
  score          Float?
  recommendation InterviewRecommendation?
  submittedAt    BigInt?                  @map("submitted_at")

  pipelineStep CandidatePipelineStep @relation(fields: [pipelineStepId], references: [id], onDelete: Cascade)
  evaluator    User                  @relation(fields: [evaluatorId], references: [id])

  @@unique([pipelineStepId, evaluatorId])
  @@map("stage_evaluation")
}

model CandidatePipeline {
  id               BigInt         @id @default(autoincrement())
  candidateId      BigInt         @map("candidate_id")
  jobId            BigInt         @map("job_id")
  applicationId    BigInt         @unique @map("application_id")
  currentStepOrder Int            @default(1) @map("current_step_order")
  overallStatus    PipelineStatus @default(IN_PROGRESS) @map("overall_status")
  startedAt        BigInt         @map("started_at")
  completedAt      BigInt?        @map("completed_at")
  lockState        PipelineLock   @default(NONE) @map("lock_state")
  pipelineMode     PipelineMode   @default(INDIVIDUAL) @map("pipeline_mode")

  candidate   User                    @relation("CandidatePipelines", fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application JobsApplied             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  steps       CandidatePipelineStep[]
  auditLogs   AuditLog[]
  interviews  Interview[]

  @@index([candidateId])
  @@index([jobId])
  @@index([overallStatus])
  @@index([pipelineMode])
  @@map("candidate_pipeline")
}

enum PipelineLock {
  NONE
  LOCKED_REJECTED
}

enum PipelineMode {
  INDIVIDUAL
  BATCH
}

enum SkillAssessmentStatus {
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
  EXPIRED
}

enum VerifiedSkillLevel {
  BEGINNER
  INTERMEDIATE
  PROFESSIONAL
  EXPERT
}

model CandidatePipelineStep {
  id             BigInt             @id @default(autoincrement())
  pipelineId     BigInt             @map("pipeline_id")
  workflowStepId BigInt             @map("workflow_step_id")
  stepOrder      Int                @map("step_order")
  status         StepInstanceStatus @default(PENDING)
  feedback       String?            @db.Text
  startedAt      BigInt?            @map("started_at")
  completedAt    BigInt?            @map("completed_at")
  skippedAt      BigInt?            @map("skipped_at")
  skippedBy      BigInt?            @map("skipped_by")
  batchId        BigInt?            @map("batch_id")

  pipeline         CandidatePipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  workflowStep     WorkflowStep      @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  batch            Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  interviews       Interview[]
  stageEvaluations StageEvaluation[]
  lois             LetterOfIntent[]
  offerLetters     OfferLetter[]

  @@index([pipelineId])
  @@index([workflowStepId])
  @@index([status])
  @@index([batchId])
  @@map("candidate_pipeline_step")
}

model Interview {
  id             BigInt                   @id @default(autoincrement())
  pipelineId     BigInt                   @map("pipeline_id")
  pipelineStepId BigInt                   @map("pipeline_step_id")
  candidateId    BigInt                   @map("candidate_id")
  feedback       String?                  @db.Text
  rating         Int?
  recommendation InterviewRecommendation?
  scheduledAt    BigInt?                  @map("scheduled_at")
  conductedAt    BigInt?                  @map("conducted_at")
  submittedAt    BigInt?                  @map("submitted_at")

  pipeline     CandidatePipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineStep CandidatePipelineStep @relation(fields: [pipelineStepId], references: [id], onDelete: Cascade)
  candidate    User                  @relation("CandidateInterviews", fields: [candidateId], references: [id])

  @@index([pipelineId])
  @@index([pipelineStepId])
  @@index([candidateId])
  @@map("interview")
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  pipelineId BigInt?     @map("pipeline_id")
  userId     BigInt      @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   BigInt      @map("entity_id")
  changes    String?     @db.Text
  timestamp  BigInt

  pipeline CandidatePipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  user     User               @relation("AuditLogs", fields: [userId], references: [id])

  @@index([pipelineId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_log")
}

model Notification {
  id         BigInt           @id @default(autoincrement())
  userId     BigInt           @map("user_id")
  title      String           @db.VarChar(255)
  message    String           @db.Text
  type       NotificationType
  entityType String?          @map("entity_type") @db.VarChar(100)
  entityId   BigInt?          @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  BigInt           @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notification")
}

// ============================================
// Bulk Hiring Batch System
// ============================================

model Batch {
  id             BigInt      @id @default(autoincrement())
  jobId          BigInt      @map("job_id")
  workflowStepId BigInt      @map("workflow_step_id")
  batchNumber    Int         @map("batch_number")
  batchName      String?     @map("batch_name") @db.VarChar(255)
  status         BatchStatus @default(PENDING_ADMIN) @map("status")
  createdBy      BigInt      @map("created_by")
  createdAt      BigInt      @map("created_at")
  updatedAt      BigInt      @map("updated_at")

  // Relations
  job             Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workflowStep    WorkflowStep            @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  creator         User                    @relation("BatchCreator", fields: [createdBy], references: [id])
  batchCandidates BatchCandidate[]
  pipelineSteps   CandidatePipelineStep[]
  applications    JobsApplied[]

  @@index([jobId])
  @@index([workflowStepId])
  @@index([status])
  @@index([createdBy])
  @@map("batch")
}

enum BatchStatus {
  PENDING_ADMIN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model BatchCandidate {
  id            BigInt               @id @default(autoincrement())
  batchId       BigInt               @map("batch_id")
  applicationId BigInt               @map("application_id")
  candidateId   BigInt               @map("candidate_id")
  currentStatus BatchCandidateStatus @default(PENDING) @map("current_status")
  evaluatedAt   BigInt?              @map("evaluated_at")
  evaluatedBy   BigInt?              @map("evaluated_by")

  // Relations
  batch       Batch                      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  application JobsApplied                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate   User                       @relation("BatchCandidateEvaluator", fields: [candidateId], references: [id], onDelete: Cascade)
  evaluator   User?                      @relation("BatchCandidateEvaluatorUser", fields: [evaluatedBy], references: [id], onDelete: SetNull)
  evaluations BatchCandidateEvaluation[]

  @@unique([batchId, candidateId])
  @@index([batchId])
  @@index([applicationId])
  @@index([candidateId])
  @@index([currentStatus])
  @@map("batch_candidate")
}

enum BatchCandidateStatus {
  PENDING
  SELECTED
  REJECTED
  REVIEW
}

model BatchCandidateEvaluation {
  id               BigInt               @id @default(autoincrement())
  batchCandidateId BigInt               @map("batch_candidate_id")
  evaluatorId      BigInt               @map("evaluator_id")
  status           BatchCandidateStatus
  feedback         String?              @db.Text
  rating           Int?
  submittedAt      BigInt               @map("submitted_at")

  // Relations
  batchCandidate BatchCandidate @relation(fields: [batchCandidateId], references: [id], onDelete: Cascade)
  evaluator      User           @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([batchCandidateId])
  @@index([evaluatorId])
  @@map("batch_candidate_evaluation")
}

// ============================================
// LOI and Offer Letter Management
// ============================================

model LetterOfIntent {
  id             BigInt       @id @default(autoincrement())
  pipelineStepId BigInt       @map("pipeline_step_id")
  candidateId    BigInt       @map("candidate_id")
  jobId          BigInt       @map("job_id")
  status         LetterStatus @default(DRAFTED)
  formData       Json         @map("form_data")
  generatedAt    BigInt?      @map("generated_at")
  sentAt         BigInt?      @map("sent_at")
  acceptedAt     BigInt?      @map("accepted_at")
  rejectedAt     BigInt?      @map("rejected_at")
  expiredAt      BigInt?      @map("expired_at")
  createdAt      BigInt       @map("created_at")
  updatedAt      BigInt       @map("updated_at")

  // Relations
  pipelineStep CandidatePipelineStep @relation(fields: [pipelineStepId], references: [id], onDelete: Cascade)
  candidate    User                  @relation("CandidateLOIs", fields: [candidateId], references: [id], onDelete: Cascade)
  job          Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  offerLetter  OfferLetter?

  @@unique([pipelineStepId, candidateId])
  @@index([candidateId])
  @@index([jobId])
  @@index([pipelineStepId])
  @@index([status])
  @@map("letter_of_intent")
}

model OfferLetter {
  id               BigInt       @id @default(autoincrement())
  letterOfIntentId BigInt       @unique @map("letter_of_intent_id")
  pipelineStepId   BigInt       @map("pipeline_step_id")
  candidateId      BigInt       @map("candidate_id")
  jobId            BigInt       @map("job_id")
  status           LetterStatus @default(DRAFTED)
  formData         Json         @map("form_data")
  generatedAt      BigInt?      @map("generated_at")
  sentAt           BigInt?      @map("sent_at")
  acceptedAt       BigInt?      @map("accepted_at")
  rejectedAt       BigInt?      @map("rejected_at")
  expiredAt        BigInt?      @map("expired_at")
  createdAt        BigInt       @map("created_at")
  updatedAt        BigInt       @map("updated_at")

  // Relations
  letterOfIntent LetterOfIntent        @relation(fields: [letterOfIntentId], references: [id], onDelete: Cascade)
  pipelineStep   CandidatePipelineStep @relation(fields: [pipelineStepId], references: [id], onDelete: Cascade)
  candidate      User                  @relation("CandidateOfferLetters", fields: [candidateId], references: [id], onDelete: Cascade)
  job            Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([pipelineStepId])
  @@index([letterOfIntentId])
  @@index([status])
  @@map("offer_letter")
}

model OrganizationSettings {
  id           BigInt  @id @default(autoincrement())
  name         String  @db.VarChar(255)
  logo         String? @db.VarChar(255)
  website      String? @db.VarChar(255)
  contactEmail String? @map("contact_email") @db.VarChar(100)
  contactPhone String? @map("contact_phone") @db.VarChar(20)
  address      String? @db.VarChar(500)
  description  String? @db.Text
  socialLinks  Json?   @map("social_links")
  locations    Json?   @map("locations")
  updatedAt    BigInt  @map("updated_at")

  @@map("organization_settings")
}

/// Singleton row holding admin-managed AI provider config.
/// The API token is stored encrypted (AES-256-GCM, see lib/ai/secret-crypto.ts) and is never returned by any API.
model AiSettings {
  id             BigInt  @id @default(autoincrement())
  endpoint       String? @db.VarChar(500)
  model          String? @db.VarChar(200)
  fallbackModel  String? @map("fallback_model") @db.VarChar(200)
  encryptedToken String? @map("encrypted_token") @db.Text
  tokenHint      String? @map("token_hint") @db.VarChar(8)
  updatedBy      BigInt? @map("updated_by")
  updatedAt      BigInt  @map("updated_at")

  @@map("ai_settings")
}

// ============================================
// AI Shortlisting
// ============================================

model AiShortlistRun {
  id               BigInt               @id @default(autoincrement())
  jobId            BigInt               @map("job_id")
  triggeredBy      BigInt               @map("triggered_by")
  status           AiShortlistRunStatus @default(RUNNING)
  totalCandidates  Int                  @default(0) @map("total_candidates")
  aiModel          String?              @map("ai_model")
  startedAt        BigInt               @map("started_at")
  completedAt      BigInt?              @map("completed_at")
  createdAt        BigInt               @map("created_at")

  job             Job                          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  triggeredByUser User                         @relation("AiShortlistRunTriggeredBy", fields: [triggeredBy], references: [id])
  results         AiCandidateShortlistResult[]

  @@index([jobId])
  @@index([status])
  @@map("ai_shortlist_run")
}

enum AiShortlistRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model AiCandidateShortlistResult {
  id            BigInt                  @id @default(autoincrement())
  runId         BigInt                  @map("run_id")
  jobId         BigInt                  @map("job_id")
  candidateId   BigInt                  @map("candidate_id")
  applicationId BigInt                  @map("application_id")

  status       AiCandidateResultStatus @default(PENDING)
  errorMessage String?                 @db.Text @map("error_message")

  overallScore             Int?                        @map("overall_score")
  skillsScore               Int?                        @map("skills_score")
  educationScore              Int?                        @map("education_score")
  experienceScore               Int?                        @map("experience_score")
  successCriteriaScore             Int?                        @map("success_criteria_score")
  assessmentScore                    Int?                        @map("assessment_score")
  quickTestScore                     Int?                        @map("quick_test_score")
  mandatoryRequirementsMet  Boolean?                    @map("mandatory_requirements_met")
  aiConfidence              Int?                        @map("ai_confidence")
  recommendation            AiShortlistRecommendation?

  matchedRequirements Json?   @map("matched_requirements")
  missingRequirements Json?   @map("missing_requirements")
  mandatoryChecklist  Json?   @map("mandatory_checklist")
  strengths           Json?
  concerns            Json?
  aiReasoning         String? @db.Text @map("ai_reasoning")

  createdAt BigInt @map("created_at")
  updatedAt BigInt @map("updated_at")

  run       AiShortlistRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate User           @relation("AiShortlistCandidateResults", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([runId, candidateId])
  @@index([runId])
  @@index([jobId])
  @@index([candidateId])
  @@map("ai_candidate_shortlist_result")
}

enum AiCandidateResultStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AiShortlistRecommendation {
  SHORTLIST
  MAYBE
  REJECT
}



// ============================================
// QUICK TEST (pre-application test)
// ============================================

model JobQuickTest {
  id               BigInt  @id @default(autoincrement())
  jobId            BigInt  @unique @map("job_id")
  isEnabled        Boolean @default(true) @map("is_enabled")
  questionCount    Int     @default(10) @map("question_count")
  timeLimitMinutes Int     @default(15) @map("time_limit_minutes")
  createdAt        BigInt  @map("created_at")
  updatedAt        BigInt  @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_quick_test")
}

enum QuickTestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model QuickTestAttempt {
  id               BigInt                 @id @default(autoincrement())
  jobId            BigInt                 @map("job_id")
  userId           BigInt                 @map("user_id")
  status           QuickTestAttemptStatus @default(IN_PROGRESS)
  questionCount    Int                    @map("question_count")
  timeLimitMinutes Int                    @map("time_limit_minutes")
  maxPoints        Int                    @default(100) @map("max_points")
  scoredPoints     Int?                   @map("scored_points")
  scorePercent     Int?                   @map("score_percent")
  aiModel          String?                @map("ai_model")
  applicationId    BigInt?                @map("application_id")
  startedAt        BigInt                 @map("started_at")
  expiresAt        BigInt                 @map("expires_at")
  submittedAt      BigInt?                @map("submitted_at")
  createdAt        BigInt                 @map("created_at")
  updatedAt        BigInt                 @map("updated_at")

  job       Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuickTestQuestion[]
  answers   QuickTestAnswer[]

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([status])
  @@map("quick_test_attempt")
}

model QuickTestQuestion {
  id            BigInt @id @default(autoincrement())
  attemptId     BigInt @map("attempt_id")
  question      String @db.Text
  options       Json
  correctOption String @map("correct_option") @db.VarChar(500)
  points        Int
  order         Int

  attempt QuickTestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  answers QuickTestAnswer[]

  @@unique([attemptId, order])
  @@index([attemptId])
  @@map("quick_test_question")
}

model QuickTestAnswer {
  id             BigInt  @id @default(autoincrement())
  attemptId      BigInt  @map("attempt_id")
  questionId     BigInt  @map("question_id")
  selectedOption String  @map("selected_option") @db.VarChar(500)
  isCorrect      Boolean @default(false) @map("is_correct")
  pointsAwarded  Int     @default(0) @map("points_awarded")
  createdAt      BigInt  @map("created_at")
  updatedAt      BigInt  @map("updated_at")

  attempt  QuickTestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuickTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("quick_test_answer")
}
