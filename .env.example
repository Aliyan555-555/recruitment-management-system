# Required: DATABASE_URL, DIRECT_URL, NEXTAUTH_SECRET, NEXTAUTH_URL.
# The app logs a clear error at startup if any are missing. Keep each key defined once and not commented out.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/your_db"
DIRECT_URL="postgresql://user:password@localhost:5432/your_db"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (optional – used for organization logos and profile avatars when set)
# Get these from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Key used to encrypt secrets saved from Admin > Settings > AI Configuration (falls back to NEXTAUTH_SECRET).
# Generate with: openssl rand -base64 32. Changing it invalidates stored tokens.
AI_SETTINGS_ENCRYPTION_KEY="generate-a-separate-secret-with-openssl-rand-base64-32"

# AI Integration (OpenRouter / OpenAI-compatible / Azure AI Inference)
# Optional fallback: values saved in Admin > Settings > AI Configuration take precedence.
AI_INFERENCE_TOKEN="sk-or-v1-your_openrouter_key"
AI_INFERENCE_ENDPOINT="https://openrouter.ai/api/v1"
AI_INFERENCE_MODEL="openai/gpt-oss-20b:free"
