# Database
DATABASE_URL="postgresql://user:password@localhost:5432/your_db"
DIRECT_URL="postgresql://user:password@localhost:5432/your_db"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (optional – used for organization logos and profile avatars when set)
# Get these from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# AI Skill Assessment (GitHub Models / Azure AI Inference)
AI_INFERENCE_TOKEN="your_github_models_token"
# Optional: fallback if AI_INFERENCE_TOKEN is unset (not recommended for production)
# GITHUB_TOKEN="your_github_token"
# Optional overrides
# AI_INFERENCE_ENDPOINT="https://models.github.ai/inference"
# AI_INFERENCE_MODEL="openai/gpt-5"
